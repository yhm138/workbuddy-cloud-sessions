{
  "name": "workbuddy-cloud-sessions",
  "version": "1.5.0",
  "description": "把 WorkBuddy 桌面端看不见的云端会话（网页版 / 微信小程序 / 定时任务）搬到侧栏：全量抓取正文、本地渲染、全文搜索、Markdown 导出。",
  "license": "MIT",
  "author": "yhm138",
  "type": "commonjs",
  "bin": {
    "wbcs": "bin/wbcs.js"
  },
  "main": "src/index.js",
  "scripts": {
    "login": "node bin/wbcs.js login",
    "fetch": "node bin/wbcs.js fetch",
    "build": "node bin/wbcs.js build",
    "deploy": "node bin/wbcs.js deploy",
    "serve": "node bin/wbcs.js serve",
    "export": "node bin/wbcs.js export",
    "all": "node bin/wbcs.js all",
    "test": "node test/run-handshake.js"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "playwright": "^1.49.0"
  },
  "files": [
    "bin",
    "src",
    "ui",
    "docs",
    "README.md",
    "LICENSE",
    "test"
  ],
  "keywords": [
    "workbuddy",
    "cloud-sessions",
    "acp",
    "playwright",
    "extension"
  ]
}
